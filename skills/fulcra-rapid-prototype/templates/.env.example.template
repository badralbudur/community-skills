# Provider auth: pick ONE of these paths. The harness auto-selects among
# whatever is present, preferring OAuth/ADC (no API key needed) over raw
# API keys -- see harness/providers/__init__.py's module docstring for the
# exact selection order.
#
# Option 1 (preferred, no API key): run `claude setup-token` once (requires
# a Claude subscription), then paste the token it prints here:
# CLAUDE_CODE_OAUTH_TOKEN=your-token-here
#
# Option 2 (preferred, no API key): run
# `gcloud auth application-default login` once, then set your GCP project:
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
#
# Option 3 (fallback, API key required): uncomment exactly one.
# GEMINI_API_KEY=your-key-here
# ANTHROPIC_API_KEY=your-key-here
# OPENAI_API_KEY=your-key-here
#
# Manual override: force a specific provider regardless of what's
# auto-detected above (that provider's own credentials still need to be
# configured via one of the options above).
# HARNESS_PROVIDER=anthropic  # or: gemini, openai
