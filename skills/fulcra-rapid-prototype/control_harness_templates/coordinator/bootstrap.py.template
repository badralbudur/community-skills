#!/usr/bin/env python3
"""Provision a full durable Fulcra Workspace control-harness baseline.

This is intentionally provider-agnostic: it uploads control artifacts and
member state, but does not invoke Generator/Evaluator models. It is safe to
re-run: root team files are create-if-absent; control artifacts are refreshed
from the local portable harness; member state/markers are refreshed.
"""
from __future__ import annotations

import argparse
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

CONTROL_HARNESS_ROOT = Path(__file__).resolve().parent.parent


def resolve_fulcra_cli() -> list[str]:
    for candidate in ("fulcra", "fulcra-api"):
        if shutil.which(candidate):
            return [candidate]
    if shutil.which("uvx"):
        return ["uvx", "fulcra-api"]
    raise RuntimeError("No Fulcra CLI found (tried fulcra, fulcra-api, uvx fulcra-api).")


def _resolve_fulcra_cli() -> list[str]:
    return resolve_fulcra_cli()


FULCRA_CLI = _resolve_fulcra_cli()


def run_cli(args: list[str], check: bool = True) -> subprocess.CompletedProcess[str]:
    result = subprocess.run([*FULCRA_CLI, *args], capture_output=True, text=True)
    if check and result.returncode:
        raise RuntimeError(f"Fulcra CLI failed: {' '.join(args)}\n{result.stderr.strip()}")
    return result


def exists(remote_path: str) -> bool:
    return run_cli(["file", "stat", remote_path], check=False).returncode == 0


def upload(remote_path: str, content: str, dry_run: bool) -> None:
    print(f"  {'[dry-run] ' if dry_run else ''}upload {remote_path}")
    if dry_run:
        return
    with tempfile.NamedTemporaryFile(mode="w", suffix=".md", delete=False) as f:
        f.write(content)
        local = Path(f.name)
    try:
        run_cli(["file", "upload", str(local), remote_path])
    finally:
        local.unlink(missing_ok=True)


def upload_file(local_path: Path, remote_path: str, dry_run: bool) -> None:
    print(f"  {'[dry-run] ' if dry_run else ''}upload {remote_path}")
    if not dry_run:
        run_cli(["file", "upload", str(local_path), remote_path])


def seed_if_absent(path: str, content: str, dry_run: bool) -> None:
    if exists(path):
        print(f"  existing {path}")
    else:
        upload(path, content, dry_run)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--team", required=True)
    parser.add_argument("--deliverable", required=True, type=Path)
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()

    team = f"team/{args.team}"
    role_path = f"{team}/role.md"
    if not exists(role_path):
        print(f"Provisioning new Workspace team: {args.team}")
        seed_if_absent(role_path, f"---\ntype: Team Role\n---\n\n# {args.team}\n\nControl harness team for `{args.deliverable}`.\n", args.dry_run)
        seed_if_absent(f"{team}/progress.md", "---\ntype: Progress Report\n---\n\n# Progress\n\nNo milestones run yet.\n", args.dry_run)
        seed_if_absent(f"{team}/completed.md", "---\ntype: Completed Objectives\n---\n\n# Completed\n\n", args.dry_run)
        seed_if_absent(f"{team}/log.md", "---\ntype: Team Log\n---\n\n# Log\n\n- Team provisioned.\n", args.dry_run)
    else:
        print(f"Joining existing Workspace team: {args.team}")

    # Upload portable control artifacts every time: these are the approved
    # current contract new/fresh roles must read, not execution history.
    artifacts = [
        ("spec.md", "knowledge/harness/spec.md"),
        ("decisions.md", "knowledge/harness/decisions.md"),
        ("dashboard-decision.md", "knowledge/harness/dashboard-decision.md"),
        ("HARNESS_GOVERNANCE.md", "knowledge/harness/HARNESS_GOVERNANCE.md"),
        ("RUNBOOK.md", "knowledge/harness/RUNBOOK.md"),
        ("coordinator/milestones.md", "knowledge/harness/coordinator/milestones.md"),
        ("coordinator/policy.md", "knowledge/harness/coordinator/policy.md"),
        ("coordinator/unattended-recovery.md", "knowledge/harness/coordinator/unattended-recovery.md"),
        ("coordinator/scheduled-operation.md", "knowledge/harness/coordinator/scheduled-operation.md"),
        ("schemas/verdict.md", "knowledge/harness/schemas/verdict.md"),
        ("schemas/decision-request.md", "knowledge/harness/schemas/decision-request.md"),
        ("schemas/message.md", "knowledge/harness/schemas/message.md"),
    ]
    print("Uploading portable control-harness artifacts:")
    for local_rel, remote_rel in artifacts:
        local = CONTROL_HARNESS_ROOT / local_rel
        if not local.is_file():
            raise RuntimeError(f"Required control artifact missing: {local}")
        upload_file(local, f"{team}/{remote_rel}", args.dry_run)

    print("Provisioning Generator/Evaluator member state:")
    for role in ("generator", "evaluator"):
        role_template = CONTROL_HARNESS_ROOT / "roles" / f"{role}.md"
        if not role_template.is_file():
            raise RuntimeError(f"Missing role template: {role_template}")
        upload_file(role_template, f"{team}/member/{role}/role.md", args.dry_run)
        seed_if_absent(f"{team}/member/{role}/progress.md", f"---\ntype: Progress Report\n---\n\n# {role.title()} Progress\n\nNo work yet.\n", args.dry_run)
        seed_if_absent(f"{team}/member/{role}/inbox/.keep.md", "Inbox marker.\n", args.dry_run)

    seed_if_absent(f"{team}/milestone-progress.md", "current: M1\ncompleted: \n", args.dry_run)
    seed_if_absent(f"{team}/status-summary.md", "---\ntype: Harness Status Summary\n---\n\n# Harness checkpoint\n\nAwaiting first run.\n", args.dry_run)
    print(f"Workspace control plane ready under {team}/")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except RuntimeError as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        raise SystemExit(1)
