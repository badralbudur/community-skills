#!/usr/bin/env python3
"""Run one milestone with durable Workspace state and pluggable host adapters.

Provider commands remain external/trusted configuration:
  HARNESS_GENERATOR_CMD, HARNESS_EVALUATOR_CMD
Optional host commands receive HARNESS_BRANCH/HARNESS_MILESTONE:
  HARNESS_PR_CREATE_CMD, HARNESS_PR_MERGE_CMD
Workspace persistence is enabled with --team (or HARNESS_TEAM). The runner
uses fulcra / fulcra-api / uvx fulcra-api, whichever is available.
"""
from __future__ import annotations

import argparse
import os
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import time
from datetime import datetime, timezone
from pathlib import Path

CONTROL_HARNESS_ROOT = Path(__file__).resolve().parent.parent
ROOT = CONTROL_HARNESS_ROOT


class MilestoneError(RuntimeError):
    pass


def _resolve_fulcra_cli() -> list[str]:
    # Compatibility/public helper name retained for scaffold regression
    # tests and external adapters.
    return resolve_fulcra()


def resolve_fulcra() -> list[str]:
    for name in ("fulcra", "fulcra-api"):
        if shutil.which(name):
            return [name]
    if shutil.which("uvx"):
        return ["uvx", "fulcra-api"]
    raise MilestoneError("No Fulcra CLI found (tried fulcra, fulcra-api, uvx fulcra-api).")


def run(cmd: list[str], cwd: Path | None = None, check: bool = True, **kwargs) -> subprocess.CompletedProcess[str]:
    result = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, **kwargs)
    if check and result.returncode:
        raise MilestoneError(f"Command failed: {' '.join(cmd)}\n{result.stderr.strip()}")
    return result


def context_for(milestone: str) -> str:
    path = ROOT / "coordinator" / "milestones.md"
    text = path.read_text()
    match = re.search(rf"^##\s+{re.escape(milestone)}:.*?(?=^##\s+|\Z)", text, re.M | re.S)
    if not match:
        raise MilestoneError(f"Milestone {milestone} not found in {path}")
    return match.group(0).strip()


def extract_milestone_context(milestone_id: str) -> str:
    """Compatibility alias used by existing scaffold tests/adapters."""
    return context_for(milestone_id)


def branch_for(milestone: str, context: str) -> str:
    title = context.splitlines()[0].split(":", 1)[-1].lower()
    slug = re.sub(r"[^a-z0-9]+", "-", title).strip("-")[:50]
    return f"milestone/{milestone.lower()}-{slug}" if slug else f"milestone/{milestone.lower()}"


def write_workspace(cli: list[str], team: str, remote: str, content: str) -> None:
    with tempfile.NamedTemporaryFile(mode="w", suffix=".md", delete=False) as f:
        f.write(content)
        local = Path(f.name)
    try:
        for attempt in range(1, 4):
            result = run([*cli, "file", "upload", str(local), f"team/{team}/{remote}"], check=False)
            if result.returncode == 0:
                return
            if attempt < 3:
                time.sleep(attempt)
        raise MilestoneError(f"Could not persist Workspace record team/{team}/{remote}")
    finally:
        local.unlink(missing_ok=True)


def persist_status(
    cli: list[str] | None,
    team: str | None,
    outcome: str,
    milestone: str,
    where: str,
    going: str,
    next_bearing: str,
) -> None:
    if not cli or not team:
        return
    now = datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")
    content = f"---\ntype: Harness Status Summary\n---\n\n# Harness checkpoint\n- **Outcome:** {outcome}\n- **Milestone:** {milestone}\n- **Updated:** {now}\n\n## Where we are\n{where}\n\n## Where we're going\n{going}\n\n## Next bearing\n{next_bearing}\n"
    write_workspace(cli, team, "status-summary.md", content)


def role_command(role: str, command: str, milestone: str, context: str, deliverable: Path, timeout: int, retries: int) -> str:
    env = os.environ.copy()
    env.update({
        "HARNESS_ROLE": role,
        "HARNESS_MILESTONE": milestone,
        "HARNESS_SPEC": str(ROOT / "spec.md"),
        "HARNESS_CONTEXT": context,
        "HARNESS_DELIVERABLE": str(deliverable),
    })
    transient = re.compile(r"429|rate limit|usage limit|session limit", re.I)
    last = ""
    for attempt in range(1, retries + 1):
        # shell=True is the documented adapter boundary for an operator-supplied
        # command string. Start a new session so timeout cleanup can terminate
        # the entire provider process group, not only the intermediate shell.
        proc = subprocess.Popen(
            command,
            shell=True,
            cwd=deliverable,
            env=env,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            start_new_session=True,
        )
        try:
            stdout, stderr = proc.communicate(timeout=timeout)
        except subprocess.TimeoutExpired:
            os.killpg(proc.pid, signal.SIGTERM)
            try:
                stdout, stderr = proc.communicate(timeout=10)
            except subprocess.TimeoutExpired:
                os.killpg(proc.pid, signal.SIGKILL)
                stdout, stderr = proc.communicate()
            last = f"{role} exceeded {timeout}s wall clock; terminated provider process group"
            retryable = True
        else:
            output = stdout + ("\n" + stderr if stderr else "")
            if proc.returncode == 0:
                return stdout
            last = f"{role} exited {proc.returncode}: {output[-2000:]}"
            retryable = bool(transient.search(output))
        if not retryable or attempt == retries:
            raise MilestoneError(last)
        time.sleep(attempt)
    raise MilestoneError(last)


def verdict_from(output: str) -> dict[str, str]:
    found: dict[str, str] = {}
    for line in output.splitlines():
        match = re.match(r"^\s*(overall|test_runner|decision_request)\s*:\s*(PASS|FAIL|true|false)\s*$", line, re.I)
        if match:
            found[match.group(1).lower()] = match.group(2).upper()
    if "overall" not in found:
        raise MilestoneError("Evaluator output missing overall: PASS|FAIL")
    return found


def is_mergeable(verdict: dict[str, str], test_runner_declared: bool) -> bool:
    """Public merge-gate helper retained for adapters and regression tests."""
    return verdict.get("overall") == "PASS" and (not test_runner_declared or verdict.get("test_runner") == "PASS")


def adapter(command: str | None, env: dict[str, str], label: str) -> None:
    if not command:
        print(f"No {label} adapter configured; leaving this as a manual host action.")
        return
    result = subprocess.run(command, shell=True, env={**os.environ, **env}, capture_output=True, text=True)
    if result.returncode:
        raise MilestoneError(f"{label} adapter failed: {result.stderr.strip()}")
    print(result.stdout)


def ensure_milestone_branch(deliverable: Path, branch: str) -> str:
    """Checkout a safe local/remote milestone branch and return start SHA.

    A fresh clone may only have `origin/<branch>`, not a local ref. Prefer
    that remote branch to preserve prior milestone work; otherwise branch
    from origin's advertised default branch, never a hardcoded `main`.
    """
    if run(["git", "-C", str(deliverable), "status", "--porcelain"], check=False).stdout.strip():
        raise MilestoneError("Deliverable is dirty before branch preparation; preserve/resume it via recovery protocol first.")
    run(["git", "-C", str(deliverable), "fetch", "origin"], check=False)
    local = run(["git", "-C", str(deliverable), "rev-parse", "--verify", branch], check=False).returncode == 0
    remote = run(["git", "-C", str(deliverable), "rev-parse", "--verify", f"origin/{branch}"], check=False).returncode == 0
    if local:
        run(["git", "-C", str(deliverable), "checkout", branch])
    elif remote:
        run(["git", "-C", str(deliverable), "checkout", "-B", branch, f"origin/{branch}"])
    else:
        default = run(["git", "-C", str(deliverable), "symbolic-ref", "--short", "refs/remotes/origin/HEAD"], check=False).stdout.strip()
        base = default or "origin/main"
        if run(["git", "-C", str(deliverable), "rev-parse", "--verify", base], check=False).returncode != 0:
            raise MilestoneError(f"Cannot resolve origin default branch for new milestone (tried {base}).")
        run(["git", "-C", str(deliverable), "checkout", "-B", branch, base])
    return run(["git", "-C", str(deliverable), "rev-parse", "HEAD"]).stdout.strip()


def has_new_commit(deliverable: Path, start_sha: str) -> bool:
    return run(["git", "-C", str(deliverable), "rev-parse", "HEAD"]).stdout.strip() != start_sha


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--milestone", required=True)
    parser.add_argument("--deliverable", type=Path, required=True)
    parser.add_argument("--team", default=os.getenv("HARNESS_TEAM"))
    parser.add_argument("--role-timeout", type=int, default=int(os.getenv("HARNESS_ROLE_TIMEOUT_SECONDS", "7200")))
    parser.add_argument("--max-retries", type=int, default=int(os.getenv("HARNESS_MAX_RETRIES", "3")))
    parser.add_argument("--no-test-runner", action="store_true")
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()
    deliverable = args.deliverable.resolve()
    if not deliverable.is_dir():
        raise MilestoneError(f"Deliverable not found: {deliverable}")
    context = context_for(args.milestone)
    branch = branch_for(args.milestone, context)
    cli = resolve_fulcra() if args.team else None
    print(f"Milestone: {args.milestone}\nBranch: {branch}")
    if args.dry_run:
        return 0

    generator = os.getenv("HARNESS_GENERATOR_CMD")
    evaluator = os.getenv("HARNESS_EVALUATOR_CMD")
    if not generator or not evaluator:
        raise MilestoneError("HARNESS_GENERATOR_CMD and HARNESS_EVALUATOR_CMD are required.")
    start_sha = ensure_milestone_branch(deliverable, branch)

    try:
        generator_output = role_command("generator", generator, args.milestone, context, deliverable, args.role_timeout, args.max_retries)
    except MilestoneError as exc:
        persist_status(cli, args.team, "ESCALATED", args.milestone, str(exc), "Provider/process execution did not complete.", "Resolve provider/process blocker, then resume this branch.")
        raise

    if run(["git", "-C", str(deliverable), "status", "--porcelain"], check=False).stdout.strip():
        raise MilestoneError("Generator returned with uncommitted work; Generator must commit/push before evaluation.")
    if not has_new_commit(deliverable, start_sha):
        raise MilestoneError("Generator made no new commit for this invocation; refusing no-op push/PR/evaluation against unchanged state.")
    run(["git", "-C", str(deliverable), "push", "-u", "origin", branch])
    host_env = {"HARNESS_BRANCH": branch, "HARNESS_MILESTONE": args.milestone, "HARNESS_DELIVERABLE": str(deliverable)}
    adapter(os.getenv("HARNESS_PR_CREATE_CMD"), host_env, "PR-create")

    evaluator_output = role_command("evaluator", evaluator, args.milestone, context, deliverable, args.role_timeout, args.max_retries)
    verdict = verdict_from(evaluator_output)
    if cli and args.team:
        write_workspace(cli, args.team, f"artifact/{args.milestone}-verdict.md", evaluator_output)
    if verdict.get("decision_request") == "TRUE":
        if cli and args.team:
            write_workspace(cli, args.team, f"decision/{args.milestone}-decision-request.md", evaluator_output)
        persist_status(cli, args.team, "DECISION REQUIRED", args.milestone, "Evaluator emitted a user decision request.", "The milestone is paused pending user input.", "Record user answer in decisions.md/spec before resuming.")
        return 1

    mergeable = is_mergeable(verdict, test_runner_declared=not args.no_test_runner)
    if not mergeable:
        persist_status(cli, args.team, "FAIL", args.milestone, f"Evaluator verdict: {verdict}", "Branch and PR remain reviewable for a bounded corrective iteration.", "Leave branch/PR open; repair process or artifact through Generator.")
        return 1
    adapter(os.getenv("HARNESS_PR_MERGE_CMD"), host_env, "PR-merge")
    if cli and args.team:
        write_workspace(cli, args.team, "milestone-progress.md", f"current: <next milestone>\ncompleted: {args.milestone}\n")
    persist_status(cli, args.team, "PASS", args.milestone, "Independent evaluator passed committed branch state.", "The harness may advance to the next milestone.", "Advance to the next milestone.")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except MilestoneError as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        raise SystemExit(1)
