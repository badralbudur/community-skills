/* Layer this after fulcra-project-dashboard's base CSS. */
.harness-panel{background:var(--panel-bg,#fffdf7);border:1px solid var(--panel-border,#d9d3c5);border-radius:14px;padding:20px;margin:16px 0;min-width:0}.harness-kicker{font:600 10px ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.12em;color:var(--muted,#587068);margin:0 0 7px}.harness-panel h2{margin:0;font:700 25px/1.05 Georgia,serif}.harness-checkpoint{background:linear-gradient(105deg,#f4fbef,#fff9ed)}.harness-checkpoint-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:15px;margin-top:18px}.harness-checkpoint-grid article{border-left:2px solid #a8cdb0;padding-left:11px}.harness-checkpoint-grid b,.harness-prior-runs>b{font:600 9px ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.08em}.harness-checkpoint-grid p{font-size:13px;line-height:1.4;margin:7px 0 0}.harness-flight-plan ol{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;padding:0;list-style:none}.harness-milestone{display:grid;grid-template-columns:32px 1fr auto;gap:9px;padding:11px;border:1px solid #d9d3c5;border-radius:9px}.harness-milestone>span{display:grid;place-items:center;width:26px;height:26px;border-radius:50%;background:#ece9de;font:600 9px ui-monospace,SFMono-Regular,Menlo,monospace}.harness-milestone p{font-size:12px;line-height:1.3;margin:4px 0 0;color:#587068}.harness-milestone em{font:600 9px ui-monospace,SFMono-Regular,Menlo,monospace;text-transform:uppercase}.harness-milestone.passed{background:#f1fbf1;border-color:#a7d7af}.harness-milestone.passed>span{background:#16784f;color:#fff}.harness-milestone.current{background:#fff5e6;border-color:#efbd90}.harness-milestone.current>span{background:#c96329;color:#fff}.harness-dashboard-grid{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(0,.85fr);gap:16px}.harness-run-panel header{display:flex;justify-content:space-between;align-items:center}.harness-run-panel label{font-size:12px}.harness-run-zoom{accent-color:#16784f;width:90px}.harness-help,.harness-empty{font-size:12px;color:#587068}.harness-run-viewport{width:100%;max-width:100%;overflow-x:auto;overflow-y:hidden;padding:22px 4px 15px;border:1px solid #d9d3c5;border-radius:10px}.harness-run-track{position:relative;min-height:105px;transition:width .2s ease}.harness-run-track:before{content:"";position:absolute;left:3%;right:3%;top:47px;height:2px;background:linear-gradient(90deg,#95c7a2,#e7c09e)}.harness-run-marker{position:absolute;top:22px;transform:translateX(-50%);border:0;background:transparent;color:#587068;cursor:pointer;text-align:center;font:600 9px ui-monospace,SFMono-Regular,Menlo,monospace}.harness-run-marker span{display:grid;place-items:center;width:34px;height:34px;margin:auto;border-radius:50%;border:2px solid #b3b7ae;background:#fffdf7}.harness-run-marker.passed span{background:#16784f;border-color:#16784f;color:#fff}.harness-run-marker.escalated span{border-color:#c96329;color:#c96329}.harness-run-marker.selected span{transform:scale(1.18);box-shadow:0 0 0 5px #f6e0c8}.harness-run-marker b,.harness-run-marker time{display:block;margin-top:6px;white-space:nowrap}.harness-run-marker time{font-size:8px;font-weight:500}.harness-run-detail{margin-top:14px;padding:14px;border-left:3px solid #1d5870;background:#edf6f1}.harness-run-detail h3{margin:4px 0;font-size:15px}.harness-run-detail em{font:600 9px ui-monospace,SFMono-Regular,Menlo,monospace;text-transform:uppercase;padding:3px 6px;border-radius:9px}.harness-run-detail em.passed{background:#dff3e3;color:#16784f}.harness-run-detail em.escalated{background:#fde7d7;color:#9e4617}.harness-prior-runs{display:grid;gap:7px;margin-top:14px;padding-top:12px;border-top:1px solid #c9ddd0}.harness-prior-runs article{display:grid;gap:3px;padding:8px;border-left:2px solid #a8cdb0;background:#f8fcf7}.harness-prior-runs article.escalated{border-left-color:#c96329;background:#fff8f1}.harness-prior-runs small,.harness-prior-runs span{font-size:11px;color:#587068}.harness-open-items ul{list-style:none;padding:0;margin:0}.harness-open-items li{padding:11px 0;border-bottom:1px solid #d9d3c5}.harness-open-items li:last-child{border:0}.harness-open-items li>b{font:600 9px ui-monospace,SFMono-Regular,Menlo,monospace;text-transform:uppercase;letter-spacing:.08em}.harness-open-items li p{font-size:13px;line-height:1.4;margin:5px 0 0}@media(max-width:760px){.harness-dashboard-grid,.harness-checkpoint-grid,.harness-flight-plan ol{grid-template-columns:1fr}.harness-run-panel header{display:block}.harness-run-panel label{display:block;margin-top:10px}}
